{
  "name": "delivery-zone-manager",
  "version": "1.9.6",
  "private": true,
  "description": "Delivery Zone Management Console for platform logistics operations",
  "main": "electron/main.js",
  "author": "Fynd Platform Team",
  "scripts": {
    "start": "node server.js",
    "electron:dev": "electron .",
    "prebuild:mac": "node scripts/increment-build.js",
    "prebuild:win": "node scripts/increment-build.js",
    "prebuild:all": "node scripts/increment-build.js",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --mac --win"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "electron-updater": "^6.8.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "nock": "^14.0.11",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.fynd.delivery-zone-manager",
    "productName": "Delivery Zone Manager",
    "copyright": "Copyright © 2025 Fynd Platform Team",
    "icon": "build/icon.png",
    "electronLanguages": [
      "en"
    ],
    "files": [
      "electron/**/*",
      "public/**/*",
      "server.js",
      "package.json",
      "build-number.json",
      "node_modules/**/*",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!node_modules/sharp/**",
      "!node_modules/.cache/**",
      "!node_modules/**/test/**",
      "!node_modules/**/tests/**",
      "!node_modules/**/*.md",
      "!node_modules/**/README*",
      "!node_modules/**/CHANGELOG*",
      "!node_modules/**/.travis.yml",
      "!node_modules/**/.npmignore",
      "!**/*.map"
    ],
    "asar": true,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "dmg": {
      "title": "Delivery Zone Manager ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Delivery Zone Manager"
    },
    "publish": {
      "provider": "github",
      "owner": "YOUR_GITHUB_USERNAME",
      "repo": "delivery-zone-manager",
      "releaseType": "release"
    }
  }
}
